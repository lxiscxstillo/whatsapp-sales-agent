# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Sales Agent — Variables de Entorno
# Copia este archivo a .env y rellena cada valor antes de ejecutar el sistema.
# NUNCA commitees el archivo .env con valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Usuario del motor de base de datos. Define libremente (ej: realestate_user).
POSTGRES_USER=realestate_user

# Contraseña de la base de datos. Usa una contraseña segura en producción.
# Genera una con: openssl rand -hex 16
POSTGRES_PASSWORD=changeme_strong_password

# Nombre de la base de datos. Define libremente (ej: realestate_db).
POSTGRES_DB=realestate_db

# Cadena de conexión completa para Prisma ORM y LangGraph checkpointer.
# En Docker Compose local usa el nombre del servicio 'postgres' como host.
# En Railway: obtén este valor desde Railway Dashboard → PostgreSQL Plugin → Connect.
DATABASE_URL=postgresql://realestate_user:changeme_strong_password@postgres:5432/realestate_db

# ── WPPConnect ────────────────────────────────────────────────────────────────
# URL del servidor WPPConnect. En local Docker usa el nombre del servicio.
# En producción: URL de tu instancia en Fly.io (ver wppconnect-config/DEPLOYMENT.md).
WPPCONNECT_URL=http://wppconnect:21465

# Clave secreta para autenticar las llamadas a la API de WPPConnect.
# Genera una con: openssl rand -hex 24
WPPCONNECT_SECRET_KEY=dev_secret_key_change_in_prod

# Nombre de la sesión de WhatsApp. Define libremente (ej: mi-empresa-ventas).
# Debe coincidir en el backend y en la configuración de WPPConnect.
WPPCONNECT_SESSION=whatsapp-sales-agent

# ── Groq API ──────────────────────────────────────────────────────────────────
# API key de Groq para el modelo LLM del agente.
# Obtén la tuya en: https://console.groq.com → API Keys → Create API Key
# El plan gratuito de Groq es suficiente para el MVP.
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── LangSmith (Observabilidad del Agente) ─────────────────────────────────────
# API key de LangSmith para trazabilidad del agente LangGraph.
# Obtén la tuya en: https://smith.langchain.com → Settings → API Keys
# El plan Developer de LangSmith es gratuito y suficiente para el MVP.
LANGCHAIN_API_KEY=ls__your_langsmith_key_here

# Activa el envío de trazas a LangSmith. Dejar en "true" para producción.
LANGCHAIN_TRACING_V2=true

# Nombre del proyecto en LangSmith donde aparecerán las trazas.
# Crea el proyecto en: https://smith.langchain.com → Projects → New Project
LANGSMITH_PROJECT=whatsapp-sales-agent

# ── Seguridad Interna ─────────────────────────────────────────────────────────
# Clave compartida entre el frontend (Next.js Route Handlers) y el backend-api.
# El frontend la envía en el header x-internal-key en cada petición al backend.
# Genera una con: openssl rand -hex 32
INTERNAL_API_KEY=dev_internal_key_change_in_prod

# ── URLs de Servicio ──────────────────────────────────────────────────────────
# URL del backend-api usada por el agente Python (service-to-service).
# En Docker Compose local usa el nombre del servicio 'backend-api'.
# En producción: URL pública de Railway (ej: https://tu-app.railway.app).
BACKEND_API_URL=http://backend-api:3001

# URL del backend-api usada por el servidor Next.js (Route Handlers, SSR).
# En local: http://localhost:3001 (o nombre del servicio si Next.js está en Docker).
# En producción en Vercel: URL pública de Railway.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
