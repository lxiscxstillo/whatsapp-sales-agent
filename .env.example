# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=realestate_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=realestate_db

# ─── WPPConnect ───────────────────────────────────────────────────────────────
# Shared secret for WPPConnect auth token generation (bcrypt)
WPPCONNECT_SECRET_KEY=your_secret_key_here
# Session name used in WPPConnect API paths
WPPCONNECT_SESSION=my-whatsapp-session

# ─── Groq API ─────────────────────────────────────────────────────────────────
# Get yours free at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── LangSmith (LangChain tracing) ───────────────────────────────────────────
# Get yours free at https://smith.langchain.com
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_TRACING_V2=true
LANGSMITH_PROJECT=whatsapp-sales-agent

# ─── Internal API (shared secret between Next.js Route Handlers and backend) ──
INTERNAL_API_KEY=changeme_internal_secret

# ─── Backend URLs ─────────────────────────────────────────────────────────────
# Used by frontend Next.js Route Handlers (server-side only, never NEXT_PUBLIC_)
BACKEND_API_URL=http://localhost:3001/api/v1

# Used by frontend client-side SWR (via Route Handlers, so this is the Next.js origin)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ─── Service URLs (internal Docker network) ───────────────────────────────────
# Set automatically by docker-compose; only override if running services manually
WPPCONNECT_URL=http://wppconnect:21465
AGENT_URL=http://localhost:8000
DATABASE_URL=postgresql://realestate_user:changeme_strong_password@localhost:5432/realestate_db
